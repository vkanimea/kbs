# Keep the build context clean and free of data/secrets.
# The context is the repo root (see docker/docker-compose.yml), so exclude
# anything that is not needed to build the system image.

.git
.github

# Secrets — never enter the build context
.env
.env.*
!.env.template

# Instance data / generated artifacts (must not be baked into the image)
kb
kb-test
examples-tmp
docker/kbs
**/rag-index
**/wiki/snapshots

# Local cruft
__pycache__
*.pyc
*.log
.obsidian
.DS_Store
Thumbs.db
