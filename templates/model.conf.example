# model.conf.example — copy to <instance>/model.conf and edit.
#
# KBS is model-agnostic: scripts read provider/model wiring from here (or from
# the environment) instead of hardcoding one. See CONVENTIONS.md §Model Wiring.
#
# Copy:  cp <system-repo>/templates/model.conf.example ~/kbs/model.conf
# Then set both keys. Any provider/model pi supports works.
#
# TIER 1: Text-Only (core KBS work — actions, failures, decisions, successes)
#   openrouter + nvidia/nemotron-3-ultra-550b-a55b:free  # $0.00/M, 100% shape pass, 35 t/s
#   openrouter + deepseek/deepseek-v4-flash-0731         # $0.656/M, 100% shape pass, 29 t/s (DEFAULT)
#   openrouter + xiaomi/mimo-v2.6-flash                  # $0.38/M, 100% shape pass, 21 t/s, +multimodal bonus
#
# TIER 2: Multimodal (image/video/audio — when vision needed)
#   openrouter + xiaomi/mimo-v2.6-flash           # $0.38/M, text+image+audio+video
#   openrouter + deepseek/deepseek-v4.1-flash     # $0.907/M, text+image
#   openrouter + stepfun/step-5-preview           # $3.70/M, text+image+video, mandatory reasoning
#   openrouter + z-ai/glm-5.3-flash               # $0.936/M, text+image+video, mandatory reasoning
#
# Leave a key commented out to force the env to supply it (resolution order:
# env -> this file -> fail loudly).

PI_PROVIDER=openrouter
PI_MODEL=deepseek/deepseek-v4-flash-0731
