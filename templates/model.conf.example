# model.conf.example — copy to <instance>/model.conf and edit.
#
# KBS is model-agnostic: scripts read provider/model wiring from here (or from
# the environment) instead of hardcoding one. See CONVENTIONS.md §Model Wiring.
#
# Copy:  cp <system-repo>/templates/model.conf.example ~/kbs/model.conf
# Then set both keys. Any provider/model pi supports works.
#
# Prices below are from the 2026-10-26 OpenRouter leaderboard, not the live API
# (they differ — check https://openrouter.ai/models before relying on a figure).
# Free tiers (e.g. NVIDIA Nemotron) and router/classifier models (e.g. TypeSafe
# Jev) are deliberately excluded: they do not do general text/coding work.
#
# TOP 3 — paid, general text/coding, ranked by lowest combined cost:
#   openrouter + z-ai/glm-5.3-flash              # $0.1214/M combined, 14.4T/wk, 1M ctx (DEFAULT)
#   openrouter + deepseek/deepseek-v4-flash-0731 # $0.2185/M combined, 4.53T/wk, 338ms latency
#   openrouter + deepseek/deepseek-v4-flash-latest # $0.4711/M combined, cheapest input, older build
#
# TIER 2: Multimodal (image/video/audio — when vision needed)
#   openrouter + xiaomi/mimo-v2.6-flash           # text+image+audio+video
#   openrouter + deepseek/deepseek-v4.1-flash     # text+image
#   openrouter + stepfun/step-5-preview           # text+image+video, mandatory reasoning
#
# Leave a key commented out to force the env to supply it (resolution order:
# env -> this file -> fail loudly).

PI_PROVIDER=openrouter
PI_MODEL=z-ai/glm-5.3-flash
