# Knowledge Base System — Environment Configuration (V11.4)
# Copy this file to .env and edit as needed
# cp .env.template .env
#
# NOTE: install.sh generates a pre-filled .env.template at install time
# (with your actual KBS_PATH/KB_NAME). This repo copy is the documented
# reference — all options, sensible defaults, and where each is consumed.

# ─── Core Paths ────────────────────────────────────────────────────────────────
KBS_PATH=$HOME/kbs
KB_NAME=main

# ─── Ingestion Behaviour ───────────────────────────────────────────────────────
# Set to true to auto-run ingestion after chat capture (requires LLM CLI)
AUTO_INGEST=false

# ─── LLM Client ────────────────────────────────────────────────────────────────
# Options: claude | openai | ollama | gemini
LLM_CLIENT=claude

# ─── API Keys (uncomment and set as needed) ────────────────────────────────────
# ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here
# GEMINI_API_KEY=your-key-here

# ─── GitHub ──────────────────────────────────────────────────────────────────
# Personal Access Token for repo push/automation (https://github.com/settings/tokens)
# Local only — .env is git-ignored; never commit the real token.
# GITHUB_TOKEN=your-token-here

# ─── Chat Adapter ──────────────────────────────────────────────────────────────
CHAT_INBOX=$KBS_PATH/CHAT_INBOX.md
CHAT_RAW_DIR=$KBS_PATH/kb/main/raw/chat-transcripts

# ─── Activity Level ────────────────────────────────────────────────────────────
# 0 = Passive (default), 1 = Mid-Active, 2 = Fully Active, 3 = Autonomous
ACTIVITY_LEVEL=0
